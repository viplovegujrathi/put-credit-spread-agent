[Unit]
Description=Put credit spread agent - dashboard login service
After=network.target
Before=nginx.service

[Service]
Type=simple
User=pcs
Group=pcs
WorkingDirectory=/opt/pcs
ExecStart=/opt/pcs/.venv/bin/python -m pcs.authd
Restart=on-failure
RestartSec=2

Environment=HOME=/opt/pcs
Environment=PCS_VIEWERS=/etc/pcs/viewers
Environment=PCS_SESSION_KEY=/var/lib/pcs/session.key
Environment=PCS_OVERRIDES=/var/lib/pcs/overrides.json

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_UNIX
# It listens on loopback only; nothing it does needs to reach the network.
IPAddressAllow=localhost
IPAddressDeny=any
# Creates /var/lib/pcs, owned by this unit's user, and adds it to
# ReadWritePaths. Everything this process writes lives there: the signing key
# and the dashboard's setting overrides.
#
# /etc/pcs is deliberately NOT writable. It is 0750 root:pcs, so the
# credentials in it can be read and not replaced -- a directory this process
# could write is a directory in which it could unlink `viewers` and put its
# own there. And nothing here can reach the ledger at all.
StateDirectory=pcs
StateDirectoryMode=0750
ReadOnlyPaths=/etc/pcs

[Install]
WantedBy=multi-user.target
