[Unit]
Description=Put credit spread agent - screen the index and build proposals
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pcs
Group=pcs
WorkingDirectory=/opt/pcs
ExecStart=/opt/pcs/deploy/pcs-refresh.sh propose
TimeoutStartSec=1800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pcs/data /opt/pcs/logs /opt/pcs/dashboard.html /var/www/pcs
